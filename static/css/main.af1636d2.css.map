.container {
    display: flex;
    flex-direction: column;
    color: white;
    font-size: large;
    font-weight: 500;
    width: 100%;
}

.choices {
    padding: 20px 15px;
    display: flex;
    align-items: center;
    gap: 40px;
}

.play {
    width: 65px;
    height: 65px;
    border-radius: 50%;
    background-color: rgb(26, 223, 26);
    display: flex;
    justify-content: center;
    align-items: center;
}

.playIcon {
    fill: black;
}

.play:hover {
    transform: scale(1.1);
    background-color: rgb(100, 224, 100);
}

.shuffle {
    border: none;
    background-color: transparent;
}

.shuffleIcon {
    width: 50px;
    height: 50px;
    color: rgb(96, 97, 97);
    transition: color 0.2s ease;
}

.shuffleIcon:hover {
    color: white;
    transform: scale(1.1);
}

.follow {
    padding: 10px;
    color: white;
    font-size: 1rem;
    font-weight: 500;
    height: 45px;
    border: 3px solid rgb(96, 97, 97);
    border-radius: 40px;
    background-color: transparent;
    transition: all 0.5s ease;
}

.follow:hover {
    border-color: white;
    transform: scale(1.1) 
}

.followOn {
    border: 3px solid goldenrod !important;
    color: goldenrod;
}