.album_container {
  padding: 5px 15px;
  display: flex;
  flex-direction: column;
  row-gap: 5px;
}

.title {
  font-weight: bold;
  font-size: 2rem;
  text-shadow: 2px 2px 2px goldenrod, -2px 1px 3px black;
  background-color: transparent;
}

.carousel_container {
    width: 100%;
    overflow: hidden;
    position: relative;
    margin: 0.5rem 0;
    flex: 1;
    display: flex;
    align-items: center;
  }

  .carousel {
    display: flex;
    align-items: center;
    transition: transform 0.5s ease-in-out;
  }
  
  .albumCard {
    min-width: 100px;
    margin: 0 20px;
    transition: all 1.5s ease-in-out;
    position: relative;
    filter: brightness(0.5);
    display: flex;
    flex-direction: column;
    text-align: center;
  }
  
  .albumCard.active {
    transform: scale(1.05);
    filter: brightness(1);
  }
  
  .albumImage {
    width: 150px;
    height: 90px;
    border-radius: 50%;
    object-fit: cover;
    box-shadow: 0 10px 20px rgba(0, 0, 0, 0.2);
    transition: all 3s ease-in-out;
  }

  .albumInfo {
    margin-top: 1rem;
    transition: all 3s ease-in-out;
  }
  
  .albumTitle {
    font-weight: 600;
    font-size: 1rem;
    margin-bottom: 0.25rem;
    color: white;
  }