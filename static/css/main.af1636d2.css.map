.container {
    color: var(--gold-light);
}

.title {
    margin-bottom: 1.5rem;
    color: var(--gold-light);
    text-align: left;
    font-weight: bold;
    font-size: 2rem;
    text-shadow: 2px 2px 2px rgb(114, 97, 53), -2px 1px 3px black;
}

.albumList {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    justify-content: space-between;
}

.albumCard {
    position: relative;
    min-width: 225px;
    max-width: 225px;
    min-height: 375px;
    border-radius: 10px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 10px;
}

.albumCard::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 50%;
    height: 2px;
    width: 0;
    background-color: goldenrod;
    transform: translateX(-50%);
    transition: width 0.3s ease;
}

.albumCard:hover {
    transform: translateY(-4px);
    cursor: pointer;
}

.albumCard:hover::after {
    width: 100%;
}

.img {
    height: 12rem;
    border-radius: 2rem;
}

.choices {
    display: flex;
    gap: 10px;
}

a {
    color: inherit;
    text-decoration: none;
}